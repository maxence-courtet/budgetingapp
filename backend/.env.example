DATABASE_URL="postgresql://user:password@localhost:5432/budget_app"
# Frontend URL: Better Auth there signs the JWTs this API accepts (keys at /api/auth/jwks)
BETTER_AUTH_URL=http://localhost:3000
PORT=3001
# Optional: enables the Dashboard "AI Insights" card (POST /api/stats/insights)
# OpenAI-compatible AI provider (Proton Lumo by default)
AI_API_KEY=
